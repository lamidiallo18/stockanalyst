# Copy to .env.local and fill in. .env.local is gitignored.

# Master secret used to encrypt provider API keys at rest (AES-256-GCM).
# Use a long, random value (>=16 chars). If you change it, previously stored
# keys can no longer be decrypted and must be re-entered.
APP_SECRET="change-me-to-a-long-random-string"

# Prisma needs DATABASE_URL for CLI commands (migrate/generate).
# The app DB is a local SQLite file under ./data.
DATABASE_URL="file:./data/app.db"

# Provider API keys are entered in the in-app Settings page (encrypted, stored
# in the local DB) — you do NOT need to put them here. These optional vars let
# you seed keys for headless/dev use instead.
# FMP_API_KEY=
# ANTHROPIC_API_KEY=
