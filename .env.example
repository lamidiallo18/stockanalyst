# Copy to .env.local and fill in. .env.local is gitignored.

# Master secret used to encrypt provider API keys at rest (AES-256-GCM).
# Use a long, random value (>=16 chars). If you change it, previously stored
# keys can no longer be decrypted and must be re-entered.
APP_SECRET="change-me-to-a-long-random-string"

# Provider API keys are entered in the in-app Settings page (encrypted, stored
# in the local DB) — you do NOT need to put them here.
