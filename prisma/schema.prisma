// StockAnalyst — local-first investment research database (v1 scope: Phases 0-2).
// SQLite via Prisma. Enums are modeled as String because SQLite has no native
// enums; canonical value sets live in src/lib/enums.ts. Every model here is
// consumed by v1 code — no speculative fields for future phases.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Provider configuration (data + LLM plugins). API keys stored encrypted.
// ---------------------------------------------------------------------------
model ProviderConfig {
  id              String   @id @default(cuid())
  providerKey     String   @unique // matches a discovered plugin manifest.key
  kind            String // "DATA" | "LLM"
  enabled         Boolean  @default(false)
  priority        Int      @default(100) // lower = tried first
  encryptedApiKey String? // AES-GCM ciphertext, never plaintext at rest
  settingsJson    String   @default("{}") // per-plugin config (non-secret)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Generic key/value app settings (valuation policy, sizing policy, model prefs).
model AppSetting {
  key       String   @id
  valueJson String   @default("{}")
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Analyses, theses, memos
// ---------------------------------------------------------------------------
model Analysis {
  id         String   @id @default(cuid())
  type       String // "STOCK" (sector/theme analysis is out of v1 scope)
  subjectRef String // ticker
  title      String
  depth      String   @default("STANDARD") // "QUICK" | "STANDARD" | "DEEP"
  status     String   @default("RUNNING") // "RUNNING" | "COMPLETE" | "ERROR"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  thesis Thesis?
  memos  Memo[]
  jobs   Job[]
}

model Thesis {
  id             String   @id @default(cuid())
  analysisId     String   @unique
  analysis       Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  userThesisText String
  createdAt      DateTime @default(now())
}

model Memo {
  id               String   @id @default(cuid())
  analysisId       String
  analysis         Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  version          Int      @default(1)
  rating           String? // ATTRACTIVE | WATCHLIST | AVOID | TOO_HARD | NEEDS_WORK
  confidence       String? // LOW | MEDIUM | HIGH
  timeHorizon      String?
  // Deterministic sizing (computed by the sizing engine, not the LLM)
  positionSizeLow  Float?
  positionSizeHigh Float?
  sizingRationale  String?
  // Provenance + scoring
  modelUsed        String?
  providerKey      String?
  compositeScore   Int?
  totalUnverified  Int      @default(0)
  // Cost accounting (amendment 7): estimate before run, actuals after
  estimatedCostUsd Float?
  actualCostUsd    Float?
  inputTokens      Int?
  outputTokens     Int?
  markdownCache    String?
  generatedAt      DateTime @default(now())

  sections MemoSection[]
  scores   Score[]

  @@index([analysisId, version])
}

model MemoSection {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  key       String // executive_summary | moat_analysis | ...
  ordering  Int      @default(0)
  contentMd String
  auditJson String   @default("[]") // unverified figures flagged by the audit
  createdAt DateTime @default(now())

  @@index([memoId])
}

model Score {
  id               String   @id @default(cuid())
  memoId           String
  memo             Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  category         String // 9 categories; see ScoreCategory in enums.ts
  value            Int
  letter           String
  rationaleMd      String?
  dataCompleteness String   @default("UNKNOWN") // LOW | MEDIUM | HIGH
  evidenceJson     String   @default("[]") // [{claim, sourceType, ref}]
  signalsJson      String   @default("[]") // [{label, value, contribution}]
  needsQualitative Boolean  @default(false)
  clamped          Boolean  @default(false) // anti-regression clamp fired (amendment 4)
  comparative      Boolean  @default(false) // scored vs peer set rather than absolute
  createdAt        DateTime @default(now())

  @@index([memoId])
}

// ---------------------------------------------------------------------------
// Provider reconciliation (amendment 2): when providers disagree >2% on the
// same reported field, the losing value is stored here and surfaced — never
// silently discarded.
// ---------------------------------------------------------------------------
model Reconciliation {
  id            String   @id @default(cuid())
  ticker        String
  field         String // e.g. "revenue", "netIncome"
  fiscalDate    String // ISO date of the period
  chosenProvider String
  chosenValue   Float
  otherProvider String
  otherValue    Float
  pctDiff       Float
  createdAt     DateTime @default(now())

  @@index([ticker, fiscalDate])
}

// ---------------------------------------------------------------------------
// External data cache + background jobs
// ---------------------------------------------------------------------------
model DataCache {
  id           String   @id @default(cuid())
  providerKey  String
  endpoint     String
  paramsHash   String
  responseJson String
  fetchedAt    DateTime @default(now())
  ttlSeconds   Int      @default(3600)

  @@unique([providerKey, endpoint, paramsHash])
}

model Job {
  id               String    @id @default(cuid())
  type             String // "ANALYSIS_MEMO"
  analysisId       String?
  analysis         Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  status           String    @default("RUNNING") // RUNNING | DONE | ERROR
  progressPct      Int       @default(0)
  currentStep      String?
  estimatedCostUsd Float? // shown in the job UI while running (amendment 7)
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
